<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;$(MinCoreTargetFramework);$(MinTargetFramework)</TargetFrameworks>

    <RootNamespace>Snoop</RootNamespace>

    <UseWpf>true</UseWpf>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Define MCP_SDK for .NET 8+ where the official SDK is available -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <DefineConstants>$(DefineConstants);MCP_SDK</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\Artwork\*.ico" />

    <Content Include="Scripts\*.psm1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <_WpfCommonNetFxReference Remove="System.Windows.Controls.Ribbon" />
  </ItemGroup>

  <ItemGroup Label="PowerShell">
    <Reference Include="System.Configuration" Condition="'$(TargetFramework)' == '$(MinTargetFramework)'" />
    <PackageReference Include="microsoft.powershell.3.referenceassemblies" PrivateAssets="All" Condition="'$(TargetFramework)' == '$(MinTargetFramework)'" />

    <PackageReference Include="System.Management.Automation" PrivateAssets="All" Condition="'$(TargetFramework)' != '$(MinTargetFramework)'" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != '$(MinTargetFramework)'">
    <DefineConstants>$(DefineConstants);USE_WPF_BINDING_DIAG</DefineConstants>
  </PropertyGroup>

  <!-- MCP SDK packages for .NET 8+ -->
  <ItemGroup Label="MCP" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>
</Project>